# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (Removed leading slashes so it applies to subfolders)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python Virtual Environments (Fixes the 10k+ files issue)
venv/
.venv/
ENV/
__pycache__/
*.pyc

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Locks down environment variables completely)
.env
.env.*
*.env
backend/.env
frontend/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
